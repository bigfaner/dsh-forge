{
  "name": "@dsh-forge/root",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build:desktop": "pnpm --filter @dsh-forge/desktop run build",
    "dev:desktop": "pnpm --filter @dsh-forge/desktop run dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:upstream-web-e2e": "node scripts/run-upstream-web-e2e.mjs",
    "lint": "oxlint .",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "project:upstream": "node scripts/vendor-project.mjs",
    "prepare:host-runtime": "node scripts/prepare-host-runtime.mjs",
    "smoke:host-entry": "node scripts/smoke-host-entry.mjs",
    "assemble:app-resources": "node scripts/assemble-app-resources.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "jsdom": "^30.1.0",
    "oxlint": "1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
