{
  "name": "dsh-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm -C apps/web build:vite",
    "dev": "node scripts/dev.mjs",
    "lint": "pnpm lint:ox && pnpm lint:imports && pnpm lint:tokens && pnpm lint:selftest && pnpm lint:types",
    "lint:ox": "oxlint -c oxlint.config.ts .",
    "lint:imports": "node scripts/lint-imports.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:selftest": "node scripts/lint-selftest.mjs",
    "lint:types": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.3",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
