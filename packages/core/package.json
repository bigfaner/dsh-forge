{
  "name": "@dsh-forge/core",
  "version": "0.10.5",
  "private": true,
  "type": "module",
  "description": "数据内核（唯一 SQLite 句柄）：forge 域（projects/补偿链/对账 + M2 四域 tasks/features/proposals/docs + settings/bugs/checkpoints），对外 ctx.forgeProjects 等服务（知识域已迁 knowledge 插件）。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "24.19.0"
  },
  "dependencies": {
    "@dsh-forge/lib-db": "workspace:*",
    "@dsh-forge/lib-diag": "workspace:*",
    "@dsh-forge/lib-git": "workspace:*",
    "@dsh-forge/lib-path": "workspace:*",
    "@dsh-forge/lib-util": "workspace:*",
    "@dsh-forge/spec": "workspace:*",
    "@dsh-forge/lib-api": "workspace:*"
  }
}
