    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  },
  "dependencies": {
    "@dsh-forge/contracts": "workspace:*",
    "@dsh-forge/path-key": "workspace:*",
    "better-sqlite3": "13.0.3"
  }
}
