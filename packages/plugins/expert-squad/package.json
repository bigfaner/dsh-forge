{
  "name": "@dsh-forge/expert-squad",
  "version": "0.12.7",
  "private": true,
  "type": "module",
  "description": "expert-squad cordis 插件（双面包装载范式）：专家档案三层扫描/注册取用、通道一委派（delegate_expert）与双通道热刷新（chokidar + fs/observed）。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "experts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-client.mjs"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "gray-matter": "4.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/node": "24.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.5"
  }
}
