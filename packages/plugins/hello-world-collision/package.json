{
  "name": "@dsh-forge/plugin-hello-world-collision",
  "description": "Collision-replica fixture: a second self-installed plugin declaring the same hello-world.panel slot key, probing ui-slots declaration-merge collision behavior (build-time modes: replica / coexist / shadow / tie)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faner-me/dsh-forge.git",
    "directory": "packages/plugins/hello-world-collision"
  },
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc --build && tsdown",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.12",
    "immer": "10.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "zustand": "4.4.7"
  }
}
