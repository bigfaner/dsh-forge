{
  "name": "@dsh-forge/git-worktree",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "git-worktree cordis 插件（通用层）：worktree/branch 管理域骨架——git 在场性启动检测 + 扩展点契约（resolveProject / worktree 目录提供者，均有默认实现）。零 dsh-forge 依赖。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dsh-forge/contracts": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@types/node": "24.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "~18.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
