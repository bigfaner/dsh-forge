{
  "name": "@dsh-forge/input-history",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "input-history cordis 插件（纯 client 包）：composer 方向键输入历史——双面包装载范式首建（client bundle 自注册 CJS + dsh.client 清单 + dsh.bundle patch，后续 edit-resend 插件复用）。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@types/node": "24.19.0",
    "@types/react": "18.3.12",
    "esbuild": "0.24.2",
    "react": "18.3.1"
  }
}
