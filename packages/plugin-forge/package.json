{
  "name": "@dsh-forge/plugin-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh 插件：forge 管线 tool 半身（六动词透传）+ forge:pipeline 系统提示段（运行期经 Cordis inject forgeTasks/forgeProposals，仅类型依赖 core 服务面）。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@dsh-forge/contracts": "workspace:*",
    "@dsh-forge/path-key": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0"
  }
}
