{
  "name": "@dsh-forge/plugin-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh 插件：forge 管线 tool 半身（六动词透传）+ forge:pipeline 系统提示段（运行期经 Cordis inject forgeTasks/forgeProposals；persona 合成单源 = @dsh-forge/core）。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.2.0-rc.2",
    "@dsh-forge/contracts": "workspace:*",
    "@dsh-forge/path-key": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3"
  }
}
