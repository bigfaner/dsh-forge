// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DDL 快照锚（前缀参数 + 表名模板） > project 前缀 DDL 快照（防抖动） 1`] = `
[
  "CREATE TABLE schema_meta (
    version     INTEGER PRIMARY KEY,
    applied_at  TEXT    NOT NULL
)",
  "CREATE TABLE project_projects (
    id                   TEXT PRIMARY KEY,
    project_key          TEXT NOT NULL UNIQUE,
    title                TEXT NOT NULL,
    forge_dir            TEXT NOT NULL,
    forge_dir_external   INTEGER NOT NULL DEFAULT 0 CHECK (forge_dir_external IN (0, 1)),
    worktree_dir         TEXT NOT NULL DEFAULT '',
    sort_order           INTEGER DEFAULT NULL,
    archived             INTEGER NOT NULL DEFAULT 0,
    created_at           TEXT NOT NULL,
    updated_at           TEXT NOT NULL
)",
  "CREATE TABLE project_workspaces (
    id                   INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id           TEXT NOT NULL REFERENCES project_projects(id) ON DELETE CASCADE,
    workspace_id         TEXT NOT NULL,
    ws_path              TEXT NOT NULL,
    member_role          TEXT NOT NULL CHECK (member_role IN ('main', 'worktree')),
    bound_at             TEXT NOT NULL,
    created_at           TEXT NOT NULL,
    UNIQUE (project_id, member_role, ws_path),
    UNIQUE (ws_path)
)",
  "CREATE UNIQUE INDEX idx_project_workspaces_main ON project_workspaces(project_id) WHERE member_role = 'main'",
  "CREATE INDEX idx_project_workspaces_ws ON project_workspaces(workspace_id, project_id)",
  "CREATE TABLE project_bugs (
    id                 TEXT PRIMARY KEY,
    project_key        TEXT NOT NULL,
    summary            TEXT NOT NULL,
    bug_desc           TEXT NOT NULL,
    trigger_desc       TEXT NOT NULL,
    expected           TEXT NOT NULL,
    actual             TEXT NOT NULL,
    suspected          TEXT,
    error_type         TEXT,
    bug_status         TEXT NOT NULL DEFAULT 'open'
                       CHECK (bug_status IN ('open', 'fixed', 'unresolved')),
    commit_hash        TEXT,
    worktree           TEXT,
    branch             TEXT,
    unresolved_reason  TEXT,
    fix_approach       TEXT,
    source_task_id     TEXT,
    recurrence_of      TEXT,
    container_slug     TEXT,
    report_session_id  TEXT,
    fix_session_id     TEXT,
    fixer              TEXT,
    reporter           TEXT NOT NULL,
    created_at         TEXT NOT NULL,
    updated_at         TEXT NOT NULL
)",
  "CREATE INDEX idx_project_bugs_status ON project_bugs(bug_status, created_at)",
]
`;
