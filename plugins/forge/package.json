{
  "name": "@dsh-forge/forge",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "forge 全家桶：一次安装获得完整交付流水线——任务规格、任务循环、专家团、知识库与 Forge/猎头双预设模式。",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./tools-exclude": {
      "types": "./dist/host/tools-exclude.d.ts",
      "import": "./dist/host/tools-exclude.js"
    },
    ".": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/ui/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "experts/"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b && node scripts/bundle-host.mjs && node scripts/bundle-client.mjs",
    "prepack": "node scripts/self-containment.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@dsh-forge/lib-diag": "workspace:*",
    "esbuild": "0.24.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@dsh-forge/expert-squad": "file:../expert-squad",
    "@dsh-forge/knowledge": "file:../knowledge",
    "@dsh-forge/project": "file:../project",
    "@dsh-forge/spec": "file:../spec",
    "@dsh-forge/task-loop": "file:../task-loop"
  }
}
