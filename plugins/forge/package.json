{
  "name": "@dsh-forge/forge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "forge 组合器包骨架（阶段一：声明面 + 双链构建链——组合段/派发单源/client 合并归 1.4）。",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/ui/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b && node scripts/bundle-host.mjs && node scripts/bundle-client.mjs",
    "prepack": "node scripts/self-containment.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.24.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@dsh-forge/project": "file:../project",
    "@dsh-forge/spec": "file:../spec",
    "@dsh-forge/task-loop": "file:../task-loop",
    "@dsh-forge/expert-squad": "file:../expert-squad",
    "@dsh-forge/knowledge": "file:../knowledge"
  }
}
