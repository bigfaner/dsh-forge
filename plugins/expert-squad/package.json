{
  "name": "@dsh-forge/expert-squad",
  "version": "0.31.6",
  "private": true,
  "type": "module",
  "description": "expert-squad cordis 插件（双面包装载范式）：专家档案三层扫描/注册取用、通道一委派（delegate_expert）与双通道热刷新（chokidar + fs/observed）。",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client/ui/index.d.ts",
      "default": "./dist/client.js"
    },
    "./expert-restrict": {
      "types": "./dist/host/expert-restrict.d.ts",
      "import": "./dist/host/expert-restrict.js"
    },
    "./tools-exclude": {
      "types": "./dist/host/tools-exclude.d.ts",
      "import": "./dist/host/tools-exclude.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "cordis.patch.yml",
    "dist",
    "experts",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b && node scripts/bundle-host.mjs && node scripts/bundle-client.mjs",
    "prepack": "node scripts/self-containment.mjs"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "gray-matter": "4.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@dsh-forge/contracts": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@types/node": "24.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.6",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
