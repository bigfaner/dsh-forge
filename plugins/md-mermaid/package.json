{
  "name": "@dsh-forge/md-mermaid",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "dsh 插件：md-mermaid——mermaid 渲染与图源校验能力单源（mermaid 依赖全仓唯一引用方；host 半 = validateMermaid tool + 引擎适配，ui 半 = React DOM 渐进增强器）",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./web": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b && node scripts/bundle-host.mjs",
    "prepack": "node scripts/self-containment.mjs"
  },
  "dependencies": {
    "mermaid": "12.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "~18.3.0",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
