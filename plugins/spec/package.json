{
  "name": "@dsh-forge/spec",
  "version": "0.20.11",
  "private": true,
  "type": "module",
  "description": "规格与共识：把想法澄清成提案、目标与验收标准，为交付流水线提供唯一事实源。",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client/ui/index.d.ts",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/host/types.d.ts"
    },
    "./typert": {
      "types": "./dist/typert.host.d.ts",
      "default": "./dist/typert.host.js"
    },
    "./remote": {
      "types": "./dist/typert.remote-client.d.ts",
      "default": "./dist/typert.remote-client.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "cordis.patch.yml",
    "dist/typert.host.js",
    "dist/typert.host.d.ts",
    "dist/typert.remote-client.js",
    "dist/typert.remote-client.d.ts",
    "dist/typert.remote-client.d.ts.map",
    "experts/"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node scripts/generate-typert.mjs && tsc -b && node scripts/bundle-host.mjs && node scripts/bundle-client.mjs",
    "prepack": "node scripts/self-containment.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@dsh-forge/contracts": "workspace:*",
    "@dsh-forge/lib-api": "workspace:*",
    "@dsh-forge/lib-db": "workspace:*",
    "@dsh-forge/lib-diag": "workspace:*",
    "@dsh-forge/lib-path": "workspace:*",
    "@dsh-forge/lib-status-machine": "workspace:*",
    "@dsh-forge/lib-util": "workspace:*",
    "@types/node": "24.19.0",
    "esbuild": "0.24.2",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ]
    }
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
