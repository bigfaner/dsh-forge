{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "dist/client",
    "rootDir": ".",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo-client"
  },
  "include": ["ui"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"],
  "references": [
    { "path": "./tsconfig.shared.json" }
  ]
}
