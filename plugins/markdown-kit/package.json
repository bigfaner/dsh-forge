{
  "name": "@dsh-forge/markdown-kit",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "dsh 插件：markdown-kit——mermaid 渲染与图源校验 + 文档转换枢纽（mermaid 依赖全仓唯一引用方；host 半 = validateMermaid/convertDocument tool + 引擎适配，ui 半 = React DOM 渐进增强器）",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./web": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./client": {
      "types": "./dist/ui/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b && node scripts/sync-version.mjs && node scripts/bundle-host.mjs && node scripts/bundle-client.mjs",
    "prepack": "node scripts/self-containment.mjs"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "mermaid": "12.1.0",
    "pdfjs-dist": "4.10.38"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "~18.3.0",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
