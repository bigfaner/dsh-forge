{
  "name": "@dsh-forge/knowledge",
  "version": "0.32.3",
  "private": true,
  "type": "module",
  "description": "dsh 插件：knowledge_search / knowledge_read_abstract tool + forge:knowledge 系统提示词知识段 + 自持知识库存储与八法服务面（provide knowledge 服务——注册表/schema 版本线/并发纪律/两级解析）",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/ui/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b && node scripts/bundle-host.mjs && node scripts/bundle-client.mjs",
    "prepack": "node scripts/self-containment.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "gray-matter": "4.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@dsh-forge/contracts": "workspace:*",
    "@dsh-forge/lib-path": "workspace:*",
    "@dsh-forge/path-key": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
