      "import": "./dist/labels.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./channels": {
      "types": "./dist/channels.d.ts",
      "import": "./dist/channels.js"
    },
    "./dto/bugs": {
      "types": "./dist/dto/bugs.d.ts",
      "import": "./dist/dto/bugs.js"
    },
    "./dto/forge": {
      "types": "./dist/dto/forge.d.ts",
      "import": "./dist/dto/forge.js"
    },
    "./dto/fs": {
      "types": "./dist/dto/fs.d.ts",
      "import": "./dist/dto/fs.js"
    },
    "./dto/knowledge": {
      "types": "./dist/dto/knowledge.d.ts",
      "import": "./dist/dto/knowledge.js"
    },
    "./dto/project": {
