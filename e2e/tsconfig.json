{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "playwright.config.ts",
    "specs/**/*.ts",
    "support/**/*.ts",
    "mobile/**/*.ts"
  ]
}
