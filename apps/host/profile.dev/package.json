{
  "name": "dsh-forge-profile-dev",
  "private": true,
  "version": "0.0.0",
  "description": "dsh-forge dev profile (dev 形态：链 workspace 构建产物——官方 web bundles 精确 pin + 产品插件 @dsh-forge/{contracts,core,project,knowledge,markdown-kit,plugin-forge,plugin-forge-spec} link 七件 + 原生依赖兜底；DSH_FORGE_DEV_PROFILE=dev 消费)。node_modules 由 pnpm 安装（cordis.yml 由每次启动重写）。",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "~1.0.4",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-base": "0.2.2-rc.5",
    "@deepseek-ai/dsh-web-app": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@dsh-forge/contracts": "link:../../../packages/contracts",
    "@dsh-forge/core": "link:../../../packages/core",
    "@dsh-forge/knowledge": "link:../../../plugins/knowledge",
    "@dsh-forge/markdown-kit": "link:../../../plugins/markdown-kit",
    "@dsh-forge/plugin-forge": "link:../../../packages/plugin-forge",
    "@dsh-forge/expert-squad": "link:../../../plugins/expert-squad",
    "gray-matter": "4.0.3",
    "@dsh-forge/plugin-forge-spec": "link:../../../packages/plugin-forge-spec",
    "@dsh-forge/project": "link:../../../plugins/project",
    "@dsh-forge/spec": "link:../../../plugins/spec",
    "@dsh-forge/task-loop": "link:../../../plugins/task-loop"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@dsh-forge/expert-squad"
      ]
    }
  }
}
